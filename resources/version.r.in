/* The resources that carry NokiaLink's version. Generated by CMake from
   resources/version.r.in into the build folder: the version is set only
   by project(... VERSION ...) and EDITION in CMakeLists.txt. */

#include "MacTypes.r"

/* The Finder's Get Info shows vers 1 as the version; vers 2 names the
   product the file belongs to. \0xA9 is the Mac Roman copyright sign. */
resource 'vers' (1) {
    @VERS_MAJOR@, @VERS_MINOR@, @VERS_STAGE@, 0x00, @VERS_REGION@,
    "@SHOWN_VERSION@",
    "@SHOWN_VERSION@, \0xA9 2026 Jack McAteer"
};

resource 'vers' (2) {
    @VERS_MAJOR@, @VERS_MINOR@, @VERS_STAGE@, 0x00, @VERS_REGION@,
    "@SHOWN_VERSION@",
    "NokiaLink @SHOWN_VERSION@"
};

/* The signature resource: NokiaLink's creator code (PROVISIONAL). */
type 'NkLk' { pstring; };

resource 'NkLk' (0, "Owner resource") {
    "NokiaLink @SHOWN_VERSION@"
};
