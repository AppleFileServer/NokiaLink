#ifndef VERSION_H
#define VERSION_H

/* NokiaLink's version. Generated by CMake from src/app/version.h.in into
   the build folder: the version is set only by project(... VERSION ...)
   and EDITION in CMakeLists.txt ("B-0.1.0", the British edition). */
#define kAppVersionP    "\p@SHOWN_VERSION@"

#endif
